#!/usr/bin/env bash
# ==============================================================================
# ai-reviewer - POSIX Shell Launcher
# ==============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if ! command -v node &>/dev/null; then
  echo "Error: Node.js (>=18) is required to run the ai-reviewer CLI." >&2
  echo "Please install Node.js from https://nodejs.org." >&2
  exit 1
fi

exec node "${SCRIPT_DIR}/ai-reviewer.js" "$@"
